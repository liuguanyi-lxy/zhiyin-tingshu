  "cards": [
    {
      "dot": "cyan",
      "title": "traceId 怎么贯穿全链路",
      "items": [
        "网关先执行 TraceGlobalFilter：取前端 X-Request-Id 或新生成，写入 MDC 并透传下游",
        "各服务 TraceFilter 从请求头读入 MDC；FeignInterceptor 再带到下一跳，一次请求全程同一个值"
      ]
    },
    {
      "dot": "amber",
      "title": "日志怎么进 ES",
      "items": [
        "9 个服务 logback 用 LogstashEncoder 输出 JSON 到 192.168.13.100:5044",
        "Logstash 写入 ES 索引 ts-{+YYYY.MM.dd}；Kibana 建 ts-* 索引模式后按 traceId 检索整条链路"
      ]
    }
  ]
